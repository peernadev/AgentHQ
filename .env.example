NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
TEAM_JOIN_CODE=
# Comma-separated Google emails allowed to use dashboard write routes (approve, done, ...)
TEAM_EMAILS=
GEMINI_API_KEY=
# Optional model overrides (defaults: gemini-3.8-flash -> gemini-3.7-flash -> gemini-3.5-flash-lite)
GEMINI_MODEL=
GEMINI_FALLBACK_MODEL=
GEMINI_LITE_MODEL=
# Demo only: 1 = if Gemini is busy, POST /api/missions returns the saved demo plan, flagged as cached
DEMO_FALLBACK=
# Task lease in minutes (default 10). Also how long an agent counts as alive after a heartbeat.
LEASE_MINUTES=
# Who plans missions: claude-code (default; an orchestrator agent, no server AI calls) or gemini (needs GEMINI_API_KEY)
AI_PROVIDER=
